# --- LLM API Keys (Chọn ít nhất 1 provider) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.z.ai/api/paas/v4/
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- Z.AI (canonical GLM provider; OPENAI_* above remains a migration alias) ---
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/paas/v4/

# --- Provider & Model Cấu hình mặc định ---
DEFAULT_PROVIDER=zai
DEFAULT_MODEL=glm-5.3-flash
# DEFAULT_PROVIDER=openai
# DEFAULT_MODEL=gpt-4o-mini

# --- GitHub Token (Tùy chọn: Tăng quota tìm kiếm repo từ 60 -> 5000 req/giờ) ---
GITHUB_TOKEN= 

# --- User Agent cho ArXiv API ---
ARXIV_USER_AGENT=AI-Research-Agent/4.0 (contact: local@lab.ai)

# --- Cờ tính năng ---
ENABLE_HITL=false
